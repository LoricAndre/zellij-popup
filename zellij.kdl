// Development layout for zellij-popup.
// Run:  zellij --config config.kdl --layout zellij.kdl
//
// Build:  cargo build
// Reload: zellij action start-or-reload-plugin file:target/wasm32-wasip1/debug/zellij-popup.wasm

layout {
    cwd "."
    pane size=1 borderless=true {
        plugin location="zellij:tab-bar"
    }
    pane edit="src/main.rs" size="80%"
    pane
    pane size=1 borderless=true {
        plugin location="zellij:status-bar"
    }
    floating_panes {
        // Hot-reload helper: watches for changes and reloads the plugin automatically.
        pane {
            plugin location="https://github.com/zellij-org/develop-rust-plugin/releases/download/v0.3.0/develop-rust-plugin.wasm"
        }
    }
}
